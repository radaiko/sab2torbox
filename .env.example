SAB2TORBOX_TORBOX_API_TOKEN=your-torbox-token
SAB2TORBOX_SAB_API_KEY=generate-a-random-key
SAB2TORBOX_WEBDAV_MOUNT_ROOT=/mnt/torbox
# Leave empty unless your TorBox WebDAV nests release folders under a subdir.
SAB2TORBOX_WEBDAV_USENET_SUBPATH=
# Required: completed downloads are published as a symlink farm under
# <SYMLINK_ROOT>/<category>/<release>/. The Sonarr/Radarr library must share
# this filesystem so the import is a rename, not a copy.
SAB2TORBOX_SYMLINK_ROOT=/mnt/smedia/_incoming
SAB2TORBOX_LISTEN_ADDR=:8080
SAB2TORBOX_DATABASE_PATH=/config/sab2torbox.db
SAB2TORBOX_POLL_INTERVAL=1m
SAB2TORBOX_LOG_LEVEL=info
SAB2TORBOX_CATEGORIES=sonarr,radarr,sonarr-anime

# Optional: force TorBox's WebDAV listing to refresh when a download finishes
# instead of waiting out its ~15-minute cycle. Set both credentials to enable;
# leave them blank to disable the feature.
SAB2TORBOX_TORBOX_WEBDAV_USER=
SAB2TORBOX_TORBOX_WEBDAV_PASS=
SAB2TORBOX_TORBOX_WEBDAV_REFRESH_URL=https://webdav.torbox.app/refresh
SAB2TORBOX_TORBOX_WEBDAV_REFRESH_COOLDOWN=2m

# Auto-heal symlinks broken by TorBox rotating releases out of storage.
# Disabled by default. When enabled, HEAL_LIBRARY_ROOTS is required.
SAB2TORBOX_HEAL_ENABLED=false
SAB2TORBOX_HEAL_INTERVAL=1h
SAB2TORBOX_HEAL_LIBRARY_ROOTS=/mnt/smedia/tv,/mnt/smedia/movies
SAB2TORBOX_HEAL_DRY_RUN=false
SAB2TORBOX_HEAL_MAX_ATTEMPTS=3
SAB2TORBOX_HEAL_BACKOFF_INITIAL=5m
